{
  "name": "shakes-pear",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "tsc --noEmit",
    "test:maestro": "maestro test maestro/flows",
    "test:maestro:library": "maestro test maestro/flows/library.yaml",
    "build:android:cloud": "eas build --platform android --profile production",
    "build:android:cloud:preview": "eas build --platform android --profile preview",
    "build:android": "node scripts/build-android-apk.js",
    "build:android:local": "node scripts/build-android-apk.js",
    "build:android:local:preview": "node scripts/build-android-apk.js",
    "build:android:local:debug": "node scripts/build-android-apk.js --debug",
    "build:android:local:eas": "eas build --platform android --profile preview --local",
    "build:ios:cloud": "eas build --platform ios --profile production",
    "build:ios:cloud:preview": "eas build --platform ios --profile preview",
    "build:all:cloud": "eas build --platform all --profile production",
    "build:ios:local:eas": "eas build --platform ios --profile production --local",
    "build:run:android": "expo run:android",
    "build:run:ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean"
  },
  "dependencies": {
    "@expo-google-fonts/cinzel": "^0.2.3",
    "@expo-google-fonts/im-fell-english": "^0.2.3",
    "@expo-google-fonts/lora": "^0.2.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-speech": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "jszip": "^3.10.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
